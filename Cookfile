use cook_dotnet
use cook_pnpm

tools release:toolchain
    dotnet

probe release:environment
    lines {
        printf 'RADARRVERSION=%s\nBUILD_SOURCEBRANCHNAME=%s\nPATH=%s\n' "${RADARRVERSION-}" "${BUILD_SOURCEBRANCHNAME-}" "$PATH"
        uname -srm
        dotnet --info
    }

probe release:sources
    lines {
        git ls-files -z --cached --others --exclude-standard -- src build.sh global.json test.sh Logo/64.png Logo/1024.png distribution/osx/Radarr.app/Contents/Info.plist | perl -0ne 'chop; print "$_\0" if -e $_ || -l $_' | tar --null -T - -cf - | git hash-object --stdin
    }

cook_dotnet.workspace({ solution = "src/Radarr.sln", root = "src", configuration = "Debug" })
cook_pnpm.workspace({
    packages = "auto",
    node = ">=20",
    pm = "pnpm@10.33.0",
    exclude_inputs = { "build/**" },
    tasks = {
        build = {
            inputs = { "frontend/**", "package.json", "pnpm-lock.yaml", "tsconfig.json" },
            outputs = { "_output/UI/" },
        },
    },
})

recipe build: "dotnet:build" "pnpm:build"
    cook.dep_output_list("dotnet:build")
    cook.dep_output_list("pnpm:build")
    cook "build/radarr/" >{
        local function copy_tree(source, destination)
            fs.mkdir_p(destination)
            cook.sh("cp -a " .. source .. "/. " .. destination .. "/")
        end

        cook.sh("rm -rf " .. output)
        for _, directory in ipairs(cook.dep_output_list("dotnet:build")) do
            if directory:match("^build/dotnet/bin/") then
                copy_tree(directory, path.join(output, "bin"))
            end
        end
        for _, directory in ipairs(cook.dep_output_list("pnpm:build")) do
            copy_tree(directory, path.join(output, "UI"))
        end
    }

recipe verify: "pnpm:build"
    seal "frontend/**" "package.json" "pnpm-lock.yaml"
    test { pnpm lint && pnpm stylelint-linux }

recipe release-linux-x64-backend
    seal release:sources release:toolchain release:environment
    cook "build/release-backend/linux-x64/net8.0/" {
        root=$PWD
        rm -rf $<out>
        mkdir -p $<out>/.work
        git ls-files -z --cached --others --exclude-standard -- src build.sh global.json test.sh Logo/64.png Logo/1024.png distribution/osx/Radarr.app/Contents/Info.plist | tar --null -T - -cf - | tar -xf - -C $<out>/.work
        cd $<out>/.work
        export DOTNET_CLI_HOME="$root/.cook/dotnet/home" NUGET_PACKAGES="$root/.cook/dotnet/packages" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1
        ./build.sh --backend -f net8.0 -r linux-x64
        mv _output "$root/$<out>/"
        cd "$root"
        rm -rf $<out>/.work
    } nondet

recipe release-linux-x64: "release-linux-x64-backend" "pnpm:build" "verify"
    seal "build.sh" "LICENSE" "src/Directory.Build.props" "distribution/osx/Radarr.app/Contents/Info.plist"
    cook.dep_output_list("release-linux-x64-backend")
    cook.dep_output_list("pnpm:build")
    cook "build/release/Radarr.linux-core-x64.tar.gz" {
        root=$PWD
        work=$(mktemp -d "$root/build/release-package.XXXXXX")
        trap 'rm -rf "$work"' EXIT
        git ls-files -z --cached --others --exclude-standard -- build.sh LICENSE src/Directory.Build.props distribution/osx/Radarr.app/Contents/Info.plist | tar --null -T - -cf - | tar -xf - -C "$work"
        cd "$work"
        cp -a "$root/$<release-linux-x64-backend>/_output" .
        cp -a "$root/_output/UI" _output/UI
        ./build.sh --packages -f net8.0 -r linux-x64
        tar -czf "$root/$<out>" -C _artifacts/linux-x64/net8.0 Radarr
    } nondet
