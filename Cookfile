use cook_dotnet
use cook_pnpm

cook_dotnet.workspace({ solution = "src/Radarr.sln", configuration = "Debug" })
cook_pnpm.workspace({
    packages = "auto",
    node = ">=20",
    pm = "pnpm@10.33.0",
    exclude_inputs = { "build/**" },
    tasks = {
        build = {
            inputs = { "frontend/**", "package.json", "pnpm-lock.yaml", "tsconfig.json" },
            outputs = { "_output/UI/" },
        },
    },
})

recipe build: "dotnet:build" "pnpm:build"
    cook "build/radarr/" { set -e; rm -rf build/radarr && export DOTNET_CLI_HOME="$(pwd)/.cook/dotnet/home" NUGET_PACKAGES="$(pwd)/.cook/dotnet/packages"; "$<dotnet:tool.dotnet.path>" publish src/NzbDrone.Console/Radarr.Console.csproj --artifacts-path build/dotnet --configuration Debug --framework net8.0 --runtime linux-x64 --no-build --no-restore -p:UseCommonOutputDirectory=true --output build/radarr/bin && "$<dotnet:tool.dotnet.path>" publish src/NzbDrone.Mono/Radarr.Mono.csproj --artifacts-path build/dotnet --configuration Debug --framework net8.0 --runtime linux-x64 --no-build --no-restore -p:UseCommonOutputDirectory=true --output build/radarr/bin && mkdir build/radarr/UI && cp -a _output/UI/. build/radarr/UI/ }
