use cook_dotnet
use cook_pnpm

tools release:toolchain
    dotnet

probe release:environment
    lines {
        printf 'RADARRVERSION=%s\nBUILD_SOURCEBRANCHNAME=%s\nPATH=%s\n' "${RADARRVERSION-}" "${BUILD_SOURCEBRANCHNAME-}" "$PATH"
        uname -srm
        dotnet --info
    }

probe release:sources
    lines {
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        fast=true
        git diff --no-ext-diff --quiet HEAD -- src build.sh global.json LICENSE || fast=false
        [ "$(git ls-files --others --exclude-standard -- src build.sh global.json LICENSE | wc -c)" -eq 0 ] || fast=false
        [ "$(git config --type=bool --get core.filemode || echo true)" = true ] || fast=false
        [ "$(git config --type=bool --get core.symlinks || echo true)" = true ] || fast=false
        [ "$(git config --type=bool --get core.sparseCheckout || echo false)" = false ] || fast=false
        git ls-files -z -- src build.sh global.json LICENSE >"$tmp/files" || fast=false
        git ls-files -v -z -- src build.sh global.json LICENSE >"$tmp/flags" || fast=false
        perl -0ne 'exit 1 unless /^H /' "$tmp/flags" || fast=false
        git check-attr --stdin -z filter working-tree-encoding <"$tmp/files" >"$tmp/attrs" || fast=false
        perl -0ne '$n++; exit 1 if $n % 3 == 0 && $_ ne "unspecified\0" && $_ ne "unset\0"' "$tmp/attrs" || fast=false
        git ls-files --eol -z -- src build.sh global.json LICENSE >"$tmp/eol" || fast=false
        perl -0ne 'exit 1 unless /^i\/([^ ]+) +w\/([^ ]+) / && $1 eq $2' "$tmp/eol" || fast=false
        if [ "$fast" = true ]; then
            printf 'clean-v1\n'
            git rev-parse HEAD:src HEAD:build.sh HEAD:global.json HEAD:LICENSE
            printf 'git=%s\nautocrlf=%s\neol=%s\n' "$(git --version)" "$(git config --type=bool --get core.autocrlf || echo false)" "$(git config --get core.eol || echo native)"
            git hash-object "$tmp/attrs" "$tmp/eol"
        else
            git ls-files -z --cached --others --exclude-standard -- src build.sh global.json LICENSE | perl -0ne 'chop; print "$_\0" if -e $_ || -l $_' | tar --null -T - -cf - | git hash-object --stdin
        fi
    }

cook_dotnet.workspace({ solution = "src/Radarr.sln", root = "src", configuration = "Debug" })
cook_pnpm.workspace({
    packages = "auto",
    node = ">=20",
    pm = "pnpm@10.33.0",
    exclude_inputs = { "build/**" },
    tasks = {
        build = {
            inputs = { "frontend/**", "package.json", "pnpm-lock.yaml", "tsconfig.json" },
            outputs = { "_output/UI/" },
        },
    },
})

recipe build: "dotnet:build" "pnpm:build"
    cook.dep_output_list("dotnet:build")
    cook.dep_output_list("pnpm:build")
    cook "build/radarr/" >{
        local function copy_tree(source, destination)
            fs.mkdir_p(destination)
            cook.sh("cp -a " .. source .. "/. " .. destination .. "/")
        end

        cook.sh("rm -rf " .. output)
        for _, directory in ipairs(cook.dep_output_list("dotnet:build")) do
            if directory:match("^build/dotnet/bin/") then
                copy_tree(directory, path.join(output, "bin"))
            end
        end
        for _, directory in ipairs(cook.dep_output_list("pnpm:build")) do
            copy_tree(directory, path.join(output, "UI"))
        end
    }

recipe verify: "pnpm:build"
    seal "frontend/**" "package.json" "pnpm-lock.yaml"
    test { pnpm lint && pnpm stylelint-linux }

recipe release-linux-x64-backend
    seal release:sources release:toolchain release:environment
    cook "build/release-backend/linux-x64/net8.0/" {
        root=$PWD
        rm -rf $<out>
        mkdir -p $<out>/.work
        git ls-files -z --cached --others --exclude-standard | tar --null -T - -cf - | tar -xf - -C $<out>/.work
        cd $<out>/.work
        export DOTNET_CLI_HOME="$root/.cook/dotnet/home" NUGET_PACKAGES="$root/.cook/dotnet/packages" DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1
        ./build.sh --backend -f net8.0 -r linux-x64
        mv _output "$root/$<out>/"
        cd "$root"
        rm -rf $<out>/.work
    } nondet

recipe release-linux-x64: "release-linux-x64-backend" "pnpm:build" "verify"
    cook.dep_output_list("release-linux-x64-backend")
    cook.dep_output_list("pnpm:build")
    cook "build/release/linux-x64/net8.0/Radarr/" {
        root=$PWD
        rm -rf $<out>
        mkdir -p $<out>/.work
        git ls-files -z --cached --others --exclude-standard | tar --null -T - -cf - | tar -xf - -C $<out>/.work
        cd $<out>/.work
        cp -a "$root/$<release-linux-x64-backend>/_output" .
        cp -a "$root/_output/UI" _output/UI
        ./build.sh --packages -f net8.0 -r linux-x64
        cp -a _artifacts/linux-x64/net8.0/Radarr/. "$root/$<out>/"
        cd "$root"
        rm -rf $<out>/.work
    } nondet
