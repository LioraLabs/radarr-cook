use cook_dotnet
use cook_pnpm

cook_dotnet.workspace({ solution = "src/Radarr.sln", configuration = "Debug" })
cook_pnpm.workspace({
    packages = "auto",
    node = ">=20",
    pm = "pnpm@10.33.0",
    exclude_inputs = { "build/**" },
    tasks = {
        build = {
            inputs = { "frontend/**", "package.json", "pnpm-lock.yaml", "tsconfig.json" },
            outputs = { "_output/UI/" },
        },
    },
})

recipe build: "dotnet:build" "pnpm:build"
    cook "build/radarr/" { set -e; rm -rf build/radarr && mkdir -p build/radarr/bin build/radarr/UI; for dir in $<in>; do case "$dir" in build/dotnet/bin/*) cp -a "$dir"/. build/radarr/bin/;; esac; done; cp -a _output/UI/. build/radarr/UI/ }
